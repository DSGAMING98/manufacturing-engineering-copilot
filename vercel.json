{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/phase5/web/index.html" },
    { "source": "/app.js", "destination": "/phase5/web/app.js" },
    { "source": "/style.css", "destination": "/phase5/web/style.css" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/run.py": {
      "maxDuration": 10,
      "excludeFiles": "{models/**,results/**,tests/**,data/**,phase3/**,paper_figures/**,docs/**}"
    }
  }
}
